import Link from "next/link";
import { TrendingUp } from "lucide-react";
import type { CaseStudy } from "../lib/types";
import type { Recommendation } from "../lib/recommend";
import { challengeLabel, productLabel } from "../lib/taxonomy";
import { primaryChallenge } from "../lib/visuals";
import { ChallengeIcon, ProductIcon } from "./icons";

/* 事例詳細の冒頭に置く「課題 → 解決策 → 成果」の解決マップ。
   課題(indigo) → 解き方(ダーク＝焦点) → 成果(emerald) の“旅”を色で見せ、
   下に「似た課題×解き方の組み合わせ」を並べて“うちならこの手”の気づきを出す。 */
export default function CaseMap({ c, similar }: { c: CaseStudy; similar: Recommendation[] }) {
  const top = c.results[0];
  return (
    <section className="overflow-hidden rounded-[28px] border border-line bg-gradient-to-br from-brand-soft/70 via-white to-accent-soft/50 p-5 shadow-[var(--shadow-card)] sm:p-7">
      <div className="mb-4 flex items-center gap-2">
        <SparkIcon />
        <span className="text-[12px] font-semibold tracking-wide text-brand">この事例の解決マップ</span>
      </div>

      {/* 課題 → 解き方 → 成果 */}
      <div className="grid items-stretch gap-2.5 md:grid-cols-[1fr_auto_1.05fr_auto_.9fr]">
        {/* 課題 */}
        <div className="rounded-2xl border border-line bg-white p-4 shadow-[var(--shadow-card)]">
          <NodeLabel color="text-brand" dot="bg-brand" icon={<ChallengeIcon slug={primaryChallenge(c)} size={13} strokeWidth={2.4} />}>課題</NodeLabel>
          <div className="mt-2.5 flex flex-wrap gap-1.5">
            {c.challenges.map((ch) => (
              <Link key={ch} href={`/challenge/${ch}`}
                className="rounded-lg bg-brand-soft px-2.5 py-1 text-[12.5px] font-semibold text-brand no-underline transition hover:bg-brand hover:text-white">
                {challengeLabel(ch)}
              </Link>
            ))}
          </div>
        </div>

        <ArrowBadge />

        {/* 解き方（ダーク＝焦点） */}
        <div className="relative overflow-hidden rounded-2xl bg-ink p-4 shadow-[0_10px_30px_rgba(11,18,32,.28)] ring-1 ring-white/5">
          <div className="absolute -right-6 -top-6 h-20 w-20 rounded-full bg-brand/25 blur-2xl" />
          <ProductIcon slug={c.productCategory} size={68} strokeWidth={1.4} className="pointer-events-none absolute -bottom-3 -right-2 text-white/10" />
          <NodeLabel color="text-brand2" dot="bg-brand2" onDark icon={<ProductIcon slug={c.productCategory} size={13} strokeWidth={2.4} />}>解き方</NodeLabel>
          <div className="relative mt-2 text-[15px] font-bold text-white">{productLabel(c.productCategory)}</div>
          <div className="relative mt-0.5 text-[12px] leading-relaxed text-slate-400">{c.product}</div>
        </div>

        <ArrowBadge />

        {/* 成果 */}
        <div className="rounded-2xl border border-accent/25 bg-accent-soft p-4 shadow-[var(--shadow-card)]">
          <NodeLabel color="text-accent" dot="bg-accent" icon={<TrendingUp size={13} strokeWidth={2.4} />}>成果</NodeLabel>
          {top ? (
            <>
              <div className="mt-2 text-[11px] text-muted">{top.metric}</div>
              <div className="tnum text-2xl font-extrabold text-accent">{top.value}</div>
            </>
          ) : (
            <div className="mt-2 text-[13px] text-muted">—</div>
          )}
        </div>
      </div>

      {/* 似た「課題 × 解き方」の組み合わせ */}
      {similar.length > 0 && (
        <div className="mt-6 border-t border-line/70 pt-5">
          <div className="mb-3 flex items-center gap-1.5 text-[12.5px] font-semibold text-ink">
            <span className="text-brand">◇</span>似た「課題 × 解き方」の組み合わせ
          </div>
          <div className="flex flex-col gap-2">
            {similar.map((r) => (
              <Link key={r.c.id} href={`/cases/${r.c.id}`}
                className="group flex flex-wrap items-center gap-x-2.5 gap-y-1.5 rounded-xl border border-line bg-white px-3.5 py-2.5 no-underline shadow-[var(--shadow-card)] transition hover:-translate-y-0.5 hover:border-brand hover:shadow-[var(--shadow-lift)]">
                <span className="flex flex-wrap gap-1">
                  {r.c.challenges.slice(0, 3).map((ch) => (
                    <span key={ch} className="rounded-md bg-brand-soft px-2 py-0.5 text-[11px] font-semibold text-brand">
                      {challengeLabel(ch)}
                    </span>
                  ))}
                </span>
                <span className="text-brand/60">→</span>
                <span className="rounded-md bg-ink px-2 py-0.5 text-[11px] font-bold text-white">{productLabel(r.c.productCategory)}</span>
                {r.c.results[0] && (
                  <span className="tnum text-[12px] font-extrabold text-accent">{r.c.results[0].value}</span>
                )}
                <span className="ml-auto text-[11px] font-semibold text-brand opacity-0 transition group-hover:opacity-100">開く →</span>
              </Link>
            ))}
          </div>
        </div>
      )}
    </section>
  );
}

function NodeLabel({ children, color, dot, onDark, icon }:
  { children: React.ReactNode; color: string; dot: string; onDark?: boolean; icon?: React.ReactNode }) {
  return (
    <div className={`flex items-center gap-1.5 ${onDark ? "text-slate-400" : color}`}>
      {icon ?? <span className={`h-1.5 w-1.5 rounded-full ${dot}`} />}
      <span className="text-[10.5px] font-bold tracking-[.14em]">{children}</span>
    </div>
  );
}

function ArrowBadge() {
  return (
    <div className="flex items-center justify-center py-0.5">
      <span className="grid h-9 w-9 place-items-center rounded-full bg-white text-brand shadow-[var(--shadow-card)] ring-1 ring-line">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" className="rotate-90 md:rotate-0">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" />
        </svg>
      </span>
    </div>
  );
}

function SparkIcon() {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" className="text-brand">
      <path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z" fill="currentColor" />
    </svg>
  );
}
