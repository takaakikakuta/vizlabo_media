import type { CaseStudy } from "../lib/types";

/* 「どの製品(提供元) → どの会社(導入先)」を一目で。カード＝1行コンパクト、詳細＝ラベル付き。 */

const TLD = /\.(co\.jp|or\.jp|ne\.jp|go\.jp|jp|com|co|io|inc|net|biz|cloud|ai|tech)$/i;
export function vendorLabel(v?: string): string {
  if (!v) return "";
  const m = v.replace(TLD, "");
  return m.split(".").slice(-1)[0] || v;
}

export default function Adoption({ c, size = "card" }: { c: CaseStudy; size?: "card" | "detail" }) {
  const provider = c.product || vendorLabel(c.vendor);
  const customer = c.customer.name || "導入企業（非公開）";

  if (size === "detail") {
    return (
      <div className="flex flex-col items-stretch gap-2 rounded-2xl border border-line bg-soft p-4 sm:flex-row sm:items-center">
        <div className="flex-1">
          <div className="text-[10.5px] font-semibold tracking-wide text-muted">提供（製品）</div>
          <div className="mt-0.5 font-bold text-ink">{provider}</div>
          {c.vendor && <div className="text-[11px] text-muted">{vendorLabel(c.vendor)}</div>}
        </div>
        <div className="flex items-center justify-center px-2 text-brand">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" className="rotate-90 sm:rotate-0">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" />
          </svg>
        </div>
        <div className="flex-1">
          <div className="text-[10.5px] font-semibold tracking-wide text-muted">導入（顧客）</div>
          <div className="mt-0.5 font-bold text-ink">{customer}</div>
          {c.customer.size && <div className="text-[11px] text-muted">{c.customer.size}</div>}
        </div>
      </div>
    );
  }

  // card: 1行コンパクト
  return (
    <div className="flex items-center gap-1.5 text-[11.5px]">
      <span className="max-w-[45%] truncate font-semibold text-ink">{provider}</span>
      <span className="shrink-0 text-brand">→</span>
      <span className="max-w-[52%] truncate text-body">{customer}</span>
    </div>
  );
}
