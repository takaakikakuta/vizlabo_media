import Link from "next/link";
import type { CaseStudy } from "../lib/types";
import { challengeLabel, productLabel } from "../lib/taxonomy";
import CaseCover from "./CaseCover";
import Adoption from "./Adoption";
import { ProductIcon } from "./icons";

/* 一覧・関連で使う事例カード。上部に生成カバー、成果の数字を主役に。 */
export default function CaseCard({ c }: { c: CaseStudy }) {
  const topResult = c.results[0];
  return (
    <Link href={`/cases/${c.id}`}
      className="card group flex flex-col overflow-hidden rounded-2xl border border-line bg-white no-underline">
      <CaseCover c={c} />

      <div className="flex flex-1 flex-col p-5">
        <div className="mb-2 inline-flex items-center gap-1 self-start rounded-md bg-soft2 px-2 py-0.5 text-[11px] text-muted">
          <ProductIcon slug={c.productCategory} size={12} strokeWidth={2.2} />
          {productLabel(c.productCategory)}
        </div>

        <h3 className="font-display text-[15.5px] leading-snug text-ink group-hover:text-brand">
          {c.title}
        </h3>

        <div className="mt-2 rounded-lg bg-soft px-2.5 py-1.5">
          <Adoption c={c} />
        </div>

        {topResult && (
          <div className="mt-3 inline-flex items-baseline gap-2 self-start rounded-xl bg-accent-soft px-3 py-1.5 ring-1 ring-accent/15">
            <span className="text-[11px] text-muted">{topResult.metric}</span>
            <span className="tnum text-[17px] font-extrabold text-accent">{topResult.value}</span>
          </div>
        )}

        <p className="mt-3 line-clamp-2 text-[13px] leading-relaxed text-body">{c.summary}</p>

        <div className="mt-4 flex flex-wrap gap-1.5 border-t border-line2 pt-3">
          {c.challenges.slice(0, 3).map((ch) => (
            <span key={ch} className="rounded-md bg-soft px-2 py-0.5 text-[11px] text-muted">
              #{challengeLabel(ch)}
            </span>
          ))}
        </div>
      </div>
    </Link>
  );
}
