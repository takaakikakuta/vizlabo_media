import Link from "next/link";
import type { CaseStudy } from "../lib/types";
import CaseCard from "./CaseCard";

/* 一覧ページ共通のグリッド。0件のときは制作代行への導線を出す（“事例が無い”を機会に変える）。 */
export default function CaseGrid({ cases }: { cases: CaseStudy[] }) {
  if (!cases.length) {
    return (
      <div className="rounded-2xl border border-line bg-soft p-8 text-center">
        <p className="text-[14px] text-body">この条件の事例はまだ登録されていません。</p>
        <Link href="/produce"
          className="mt-4 inline-block rounded-xl bg-brand px-5 py-2.5 text-[13px] font-semibold text-white no-underline hover:bg-brand-dark">
          自社の事例を制作・掲載したい方はこちら
        </Link>
      </div>
    );
  }
  return (
    <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cases.map((c) => <CaseCard key={c.id} c={c} />)}
    </div>
  );
}

/* ページ見出し（一覧ページ共通） */
export function ListHead({ eyebrow, title, sub, count }:
  { eyebrow?: string; title: string; sub?: string; count?: number }) {
  return (
    <div className="mb-7">
      {eyebrow && <p className="mb-2 inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-3 py-1 text-[12px] font-semibold text-brand"><span className="h-1.5 w-1.5 rounded-full bg-brand" />{eyebrow}</p>}
      <h1 className="font-display text-2xl text-ink sm:text-[32px]">{title}</h1>
      {sub && <p className="mt-2 text-[14px] leading-relaxed text-body">{sub}</p>}
      {count != null && <p className="mt-2 text-[13px] text-muted">{count}件の事例</p>}
    </div>
  );
}
